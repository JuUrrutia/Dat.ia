# ==============================================================================
# DATIA - CONFIGURACIÓN DE ENTORNO LOCAL
# ==============================================================================

# Entorno de Ejecución (development | production)
# Si se cambia a "production", el servidor exigirá que se configure un SECRET_KEY único
# y no permitirá iniciar con la clave por defecto del repositorio.
ENVIRONMENT=development

# Configuración del Servidor Backend
HOST=127.0.0.1
PORT=8000

# Firma de tokens JWT. Este valor es el DEFAULT de desarrollo y
# main.py:validate_startup_security RECHAZA el arranque con
# ENVIRONMENT=production si la clave sigue siendo esta.
SECRET_KEY=democratizacion_datos_super_secret_key_local_2026_aes256_change_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cifrado de credenciales de conectores (columnas encrypted_*). Sin valor,
# security.py genera una clave por proceso, así que lo ya cifrado deja de
# poder leerse al reiniciar. Generar una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Base de datos SQLite de datos corporativos: config.py la resuelve sola
# (SQLITE_DB_PATH = backend/demo_corporativa.db) y el admin la cambia por
# conector. No existe variable de entorno para ella.

# Configuración de IA Local (Ollama / LM-Studio / llama.cpp)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OPENAI_COMPATIBLE_URL=http://localhost:8000/v1
OPENAI_COMPATIBLE_API_KEY=lm-studio

# Configuración PostgreSQL Opcional (Modo Empresarial)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=democratizacion_metadatos
