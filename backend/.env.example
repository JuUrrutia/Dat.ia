# ==============================================================================
# DATIA - CONFIGURACIÓN DE ENTORNO LOCAL
# ==============================================================================

# Entorno de Ejecución (development | production)
# Si se cambia a "production", el servidor exigirá que se configure un SECRET_KEY único
# y no permitirá iniciar con la clave por defecto del repositorio.
ENVIRONMENT=development

# Configuración del Servidor Backend
HOST=127.0.0.1
PORT=8000
SECRET_KEY=democratizacion_datos_super_secret_key_local_2026_aes256_change_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Base de Datos SQLite Activa (mental_health.sqlite o demo_corporativa.db)
SQLITE_DB_NAME=mental_health.sqlite

# Endpoint Abierto Demo (Deshabilitado por defecto para evitar bypass RBAC)
# Si es true, /chat/query-open funcionará pero forzado estrictamente al rol base 'Usuario'.
ALLOW_OPEN_DEMO_ENDPOINT=false

# Configuración de IA Local (Ollama / LM-Studio / llama.cpp)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OPENAI_COMPATIBLE_URL=http://localhost:8000/v1
OPENAI_COMPATIBLE_API_KEY=lm-studio

# Configuración PostgreSQL Opcional (Modo Empresarial)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=democratizacion_metadatos
